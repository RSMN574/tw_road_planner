# 複製成 .env 後修改（.env 不要提交到 git）。全部都有預設值，最少什麼都不用填就能啟動。
PORT=8080
HOST=0.0.0.0
# 網頁（npm run build 產生的 dist/）與資料資料夾
STATIC_DIR=dist
DATA_DIR=data
# 全台 OSM 道路圖：DATA_DIR/osm/graph（npm run osm:build 產生；v1.18 起是唯一的路網）

# 放在 Caddy／Nginx 後面時設 1（用 X-Forwarded-For 判斷用戶 IP、送 HSTS）
TRUST_PROXY=0
# 允許跨網域呼叫 API 的來源（逗號分隔；同網域的網頁不用設）
CORS_ORIGINS=
# 限流：每個 IP 每分鐘
RATE_LIMIT_PER_MIN=120
TDX_RATE_LIMIT_PER_MIN=60
# 路線計算放在背景執行緒（worker_threads）：0＝主執行緒同步計算；N＝N 個執行緒（每個各載入一份全台 OSM 道路圖，記憶體約 N 倍）
WORKERS=1
# 單次計算上限（毫秒）：超過回 504 並重開該執行緒
WORKER_TIMEOUT_MS=60000

# TDX（只放在伺服器；網頁會自動改用內建代理 /tdx）：向 token 端點要 token
TDX_TOKEN_URL=
TDX_API_KEY=
TDX_CACHE_MS=15000

# 管理：POST /api/v1/admin/reload（Authorization: Bearer <ADMIN_TOKEN>）
ADMIN_TOKEN=
# 資料檔變更時自動重新載入（大路網重建期間 API 會暫停回應數秒）
WATCH_DATA=0

# 直接由 Node 提供 HTTPS（一般建議改用 Caddy 自動憑證）
#TLS_CERT=/etc/ssl/certs/site.pem
#TLS_KEY=/etc/ssl/private/site.key
# 大路網（上百萬節點）記憶體不夠時：NODE_OPTIONS=--max-old-space-size=4096

# v1.11 全台大眾運輸規劃（/api/v1/transit/plan）：資料由 node tools/transit-sync.mjs --rail TRA,THSR --operators … --extras 抓到 CACHE_DIR/transit
#CACHE_DIR=.cache
#TRANSIT_CITY=all               # 公車：all＝全台 22 縣市＋公路客運＋台灣好行；也可以填一個或多個 TDX City 代碼（Taipei,NewTaipei,InterCity,TaiwanTrip）；空白＝不含公車
#TRANSIT_SYNC_HOURS=6           # 伺服器每 N 小時自動同步到期的大眾運輸資料（0＝不自動）
#TRANSIT_METRO=TRTC,NTMC,TYMC,KRTC,TMRT,KLRT,NTDLRT,NTALRT
#TRANSIT_RAIL=TRA,THSR
#TRANSIT_MAX_WALK_M=1000         # 起終點步行上限（公尺）
# v1.11 道路事件：node tools/traffic-sync.mjs 寫到 CACHE_DIR/traffic/events.json（建議排程每 1～5 分鐘）；路線 API 預設避開封閉（events=0 關閉）

# v1.11 工具（transit-sync、traffic-sync）直接向 TDX 官方取 token：TDX 會員中心 → 資料服務 → API 金鑰 的 Client Id／Client Secret（只放在 .env，不要提交）
#TDX_CLIENT_ID=
#TDX_CLIENT_SECRET=

# v1.15 即時路況（TDX 路況資訊 v2）：伺服器每 N 分鐘自動更新（需要上面的 TDX 金鑰；13 次呼叫／次，每 5 分鐘約 2.5 點／天）。0＝不自動更新
TRAFFIC_POLL_MIN=5
