# 複製成 .env 後修改（.env 不要提交到 git）。全部都有預設值，最少什麼都不用填就能啟動。
PORT=8080
HOST=0.0.0.0
# 網頁（npm run build 產生的 dist/）與資料資料夾
STATIC_DIR=dist
DATA_DIR=data
# 路網：DATA_DIR/graph/{nodes,edges,roads}.json
# 選用資料（存在才載入，網頁也會自動載入同一份）：
#ROAD_TABLE=road-attrs.json
#BUS_GRAPH=bus/graph.json
#METRO=metro.json
#YOUBIKE=ubike.json

# 放在 Caddy／Nginx 後面時設 1（用 X-Forwarded-For 判斷用戶 IP、送 HSTS）
TRUST_PROXY=0
# 允許跨網域呼叫 API 的來源（逗號分隔；同網域的網頁不用設）
CORS_ORIGINS=
# 限流：每個 IP 每分鐘
RATE_LIMIT_PER_MIN=120
TDX_RATE_LIMIT_PER_MIN=60
# 起訖點離最近道路節點超過幾公尺就拒絕
MAX_SNAP_M=1000
# 路線演算法：dijkstra / astar / bidir / mlevel
ROUTER=astar
# A* 地標（ALT）快取組數（每組約 節點數×32 bytes）與啟動預熱
ALT_CACHE=12
WARMUP=1

# TDX（只放在伺服器；網頁會自動改用內建代理 /tdx）：向 token 端點要 token
TDX_TOKEN_URL=
TDX_API_KEY=
TDX_CACHE_MS=15000

# 管理：POST /api/v1/admin/reload（Authorization: Bearer <ADMIN_TOKEN>）
ADMIN_TOKEN=
# 資料檔變更時自動重新載入（大路網重建期間 API 會暫停回應數秒）
WATCH_DATA=0

# 直接由 Node 提供 HTTPS（一般建議改用 Caddy 自動憑證）
#TLS_CERT=/etc/ssl/certs/site.pem
#TLS_KEY=/etc/ssl/private/site.key
# 大路網（上百萬節點）記憶體不夠時：NODE_OPTIONS=--max-old-space-size=4096
